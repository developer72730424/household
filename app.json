{
  "expo": {
    "name": "シンプル家計簿",
    "slug": "household",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "household",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sinmouri14.household",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "./plugins/with-xcode27-fixes.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "家計簿のロックを解除するために Face ID を使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "レシートの写真を選んで記録に添付するために、写真ライブラリへアクセスします。",
          "cameraPermission": "レシートを撮影して記録に添付するために、カメラを使用します。",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c2f5074-aeb4-432b-9d31-d49f0e115220"
      }
    }
  }
}
